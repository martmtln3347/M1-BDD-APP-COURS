# Facultatif pour une demo : docker-compose.yml fournit des valeurs par defaut.
# Pour tout autre usage : copier ce fichier en .env (dans ce dossier) et choisir
# de vrais mots de passe, au moins 20 caracteres aleatoires chacun
# (openssl rand -base64 24), jamais les memes pour les quatre roles.
# Le .env n'est pas versionne.

POSTGRES_DB=nook_manager
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_moi_superuser
POSTGRES_PORT=5432

# Role utilise par l'application PHP (droits limites, soumis a la RLS)
ACNH_APP_PASSWORD=change_moi_app

# Role d'administration (psql, pgAdmin, script de peuplement), BYPASSRLS
ACNH_ADMIN_PASSWORD=change_moi_admin

REDIS_PASSWORD=change_moi_redis
REDIS_PORT=6379

APP_PORT=8080

# dev : l'API renvoie les liens de verification et de reinitialisation (pas de
# serveur mail). Ne fonctionne que sur localhost, mais ne jamais laisser en production.
APP_ENV=dev
